{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loop",
  "version": "0.1.0",
  "identifier": "ing.loop.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../loop-ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../loop-ui",
    "frontendDist": "../../loop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Loop",
        "width": 1280,
        "height": 840,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}